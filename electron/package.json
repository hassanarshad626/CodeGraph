{
  "name": "codegraph",
  "version": "0.1.0",
  "description": "Live code graph & shared context for AI agents",
  "author": "CodeGraph",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.codegraph.app",
    "productName": "CodeGraph",
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "icon.ico",
      "icon_tray.png"
    ],
    "extraResources": [
      {
        "from": "../dist/codegraph-backend",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "../frontend",
        "to": "frontend",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "icon.png",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
